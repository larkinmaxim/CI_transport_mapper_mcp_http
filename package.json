{
  "name": "xml-transformer-mcp",
  "version": "1.0.0",
  "description": "HTTP Streamable MCP Server for XML Transformation (Inbound Tour → Outbound Transport)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "cross-env MCP_TRANSPORT=http node dist/server.js",
    "dev": "nodemon --exec ts-node --esm src/server.ts",
    "dev:http": "cross-env MCP_TRANSPORT=http nodemon --exec ts-node --esm src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "xml",
    "transformation",
    "transport",
    "logistics"
  ],
  "author": "XML Transformation Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "express": "^5.1.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
